# LearnLoop LMS — copy these into your Supabase project dashboard
# (Project Settings → API) or a local .env file. NEVER commit real keys.
#
# VITE_SUPABASE_URL=https://xyzcompany.supabase.co
#   (bare project URL — no trailing /rest/v1; the client appends paths itself)
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
#
# Optional:
# VITE_PAYMENTS_MODE=demo        # demo | razorpay
# VITE_RAZORPAY_KEY_ID=rzp_test_...
#
# --- First admin account (no hardcoded credentials) ---
# 1. Sign up once via the Admin Login page (/admin/login) — this creates a
#    normal student profile.
# 2. In Supabase Dashboard → Table Editor → profiles, set that row's
#    role to 'admin':
#      update public.profiles set role = 'admin' where email = 'you@example.com';
# 3. Log in again at /admin/login. Non-admin users are signed out and denied.
